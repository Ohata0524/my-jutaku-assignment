// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum EntryStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  name       String
  role       Role     @default(USER)
  
  // 作成日と更新日
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  projects Project[]
  entries  Entry[]

  @@map("users")
}

model Project {
  id         String    @id @default(cuid())
  title      String
  detail     String    @db.Text
  skills     String
  unit_price Int       
  deadline   DateTime
  deleted_at DateTime?

  // 作成日と更新日
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  user_id String
  user    User      @relation(fields: [user_id], references: [id])
  entries Entry[]

  @@map("projects")
}

model Entry {
  id         String      @id @default(cuid())
  status     EntryStatus @default(PENDING)

  // 作成日と更新日
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  user_id    String
  user       User        @relation(fields: [user_id], references: [id])
  project_id String
  project    Project     @relation(fields: [project_id], references: [id])

  @@unique([user_id, project_id])
  @@map("entries")
}

